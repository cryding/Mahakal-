# ==============================================================================
# MAHAKAL Server & Deployment Environment Variables (.env.example)
# SAFE TEMPLATE CONTAINING NON-SENSITIVE PLACEHOLDERS ONLY
# NEVER COMMIT ACTUAL CREDENTIALS, SECRETS, OR PRODUCTION KEYS TO GIT REPOSITORIES
# ==============================================================================

# Application Environment Mode: development | staging | production
APP_ENV=development

# Server API Bind and Public Ingress URL
API_PORT=8080
API_BASE_URL=https://api.mahakal.internal/v1

# Production Database (PostgreSQL / High-Availability Managed Cluster)
# In-app Android / local runtime uses Room (SQLite) with schema-safe migrations.
DATABASE_URL=postgresql://mahakal_user:PLACEHOLDER_PASSWORD@db-primary.internal:5432/mahakal_ledger_prod
DATABASE_POOL_MIN_SIZE=10
DATABASE_POOL_MAX_SIZE=50
DATABASE_SSL_MODE=require
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Authentication & Session Security Tokens
# Must be generated via: openssl rand -base64 48
SESSION_SECRET=PLACEHOLDER_SESSION_SECRET_REPLACE_IN_PRODUCTION
TOKEN_SIGNING_SECRET=PLACEHOLDER_TOKEN_SIGNING_SECRET_REPLACE_IN_PRODUCTION
ACCESS_TOKEN_EXPIRY_SECONDS=3600
REFRESH_TOKEN_EXPIRY_SECONDS=604800

# Data-At-Rest Encryption Keys (AES-256-GCM)
# Must be 32 bytes base64 encoded: openssl rand -base64 32
ENCRYPTION_KEY=PLACEHOLDER_ENCRYPTION_KEY_32_BYTES_BASE64

# Logging, Audit & Telemetry
LOG_LEVEL=INFO
STRUCTURED_JSON_LOGGING=true
SENTRY_DSN=PLACEHOLDER_SENTRY_DSN

# Security & CORS Allowed Origins
CORS_ALLOWED_ORIGINS=https://admin.mahakal.internal,https://agent.mahakal.internal

# Push Notification Service Provider Configuration
PUSH_PROVIDER=FCM
PUSH_PROVIDER_PROJECT_ID=mahakal-production
PUSH_CREDENTIALS_JSON_PATH=/etc/secrets/push-credentials.json

# Background Worker Settings
OUTBOX_POLL_INTERVAL_MS=10000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_RETRIES=5

# Android Release Signing Variables (For CI/CD runners only - injected via GitHub Secrets)
# KEYSTORE_PATH=/secrets/upload-keystore.jks
# STORE_PASSWORD=REPLACE_VIA_CI_SECRETS
# KEY_PASSWORD=REPLACE_VIA_CI_SECRETS
# UPLOAD_KEY_ALIAS=upload
